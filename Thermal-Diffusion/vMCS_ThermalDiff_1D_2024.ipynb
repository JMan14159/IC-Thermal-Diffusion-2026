    "tempData3 = TS.flatset(tempData3,lagTime,dataTime)\n",
    "tempData4 = TS.tempConvert(rawData[:,3],rawData[:,2],att,T_air,T_0,1,Gain,lagTime)\n",
    "tempData4 = TS.flatset(tempData4,lagTime,dataTime)\n",
    "\n",
    "ana = TS.anaMet(Q,A,kappa,s,dur,d1,h,a,False,lagTime,dt)\n",
    "#temp2 = np.zeros(int((dataTime+lagTime)/dt))\n",
    "#temp2[int(lagTime/dt):] = y[int((atX+d1)/dx),:]\n",
