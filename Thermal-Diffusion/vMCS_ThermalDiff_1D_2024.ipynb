    "\n",
    "plt.figure(figsize=(11, 7))\n",
    "#plt.figure(figsize=(20, 10))\n",
    "# plt.figure(figsize=(5, 4))\n",
    "\n",
    "# Plotting temperatures - Yash\n",
    "time_model = np.arange(0,lagTime+dataTime,dt)\n",
    "#plt.plot(time_model+att*0.5,ana,color=\"green\",label=\"analytical\")\n",
    "plt.plot(np.arange(0,lagTime+dataTime,0.01),tempData1*1,label=\"exp column 6\")\n",
    "plt.plot(np.arange(0,lagTime+dataTime,0.01),tempData2*1,label=\"exp column 5\")\n",
    "plt.plot(np.arange(0,lagTime+dataTime,0.01),tempData3*1,label=\"exp column 4\")\n",
    "plt.plot(np.arange(0,lagTime+dataTime,0.01),tempData4*1,label=\"exp column 3\")\n",
