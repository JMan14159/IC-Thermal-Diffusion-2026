    "# numerical plot at x=8\n",
    "d1 =  3.49\n",
    "# I found that a d1 of 8.6 and multiplying the experimental data by 1.065 with h = .000425 gave good visual agreement, numerical and experiment\n",
    "\n",
    "\n",
    "tempData1 = TS.tempConvert(rawData[:,6],rawData[:,2],att,T_air,T_0,1,Gain,lagTime)\n",
    "tempData1 = TS.flatset(tempData1,lagTime,dataTime)\n",
    "tempData2 = TS.tempConvert(rawData[:,5],rawData[:,2],att,T_air,T_0,1,Gain,lagTime)\n",
    "tempData2 = TS.flatset(tempData2,lagTime,dataTime)\n",
